; Held by its own order: past the ball's edge, it feels how fast it's coming back in against its neighbours, and comes back at the speed it should. The caster ingrains it and walks away.
        .use  Bench, Orders

HoldCohere:
        CALL  pour
        ORDR  n16, .order
        CALL  release
        MOV   n0, n16
        HALT

.order: CALL  cohere
        RET
