; Held by its own order: knowing only what it feels, it pulls back toward thicker mana when it's at the edge. The caster ingrains it and walks away.
        .use  Bench, Shapes, Orders

HoldFeel:
        CALL  pour
        CALL  edge                ; how thin the edge is: all it's told
        ORDR  n16, .order
        CALL  release
        MOV   n0, n16
        HALT

.order: CALL  feel
        RET
