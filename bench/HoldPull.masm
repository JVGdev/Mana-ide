; Held by its own order: knowing where it is from the centre, it pulls back in when it strays past the radius (17 instructions). The caster ingrains it and walks away.
        .use  Bench, Shapes, Orders

HoldPull:
        CALL  pour
        ORDR  n16, .order
        CALL  release
        MOV   n0, n16
        HALT

.order: CALL  pull
        RET
