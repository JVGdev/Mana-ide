; Held by hand while it's maintained: every particle in turn, round and round, pushed back in when it strays.
        .use  Bench

HoldEvery:
        CALL  pour
        MANI  n16
        MOV   n4, n16
        LDI   n14, #0.5
        LDI   n21, #0
.keep:  CIRC  m0
        CALL  hold
        IN    n17, MAINTAIN
        CMP   n17, #0
        JNE   .keep
        MOV   n0, n16
        HALT
