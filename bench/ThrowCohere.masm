; Thrown by hand, held by its own order: past the edge, it feels how fast it's coming back in against its neighbours, and comes back at the speed it should.
        .use  Bench, Reactions, Transformations, Orders

ThrowCohere:
        CALL  pour
        ORDR  n16, .order
        CALL  release
        CALL  aim
        MOV   n4, n16
        CALL  throw
        LOCK  n16, INPUT
        MOV   n0, n16
        HALT

.order: GETW  n5, #0              ; the phase: 0 flying, 1 bursting
        CMP   n5, #0
        JNE   .burst
        CALL  touch
        CMP   n5, #0
        JNE   .hit
        CALL  cohere
        RET
.hit:   PUTW  #0, n5              ; it bursts from the next tick, and the word passes by touch
        PUTW  #4, n4
        RET
.burst: CALL  burst
        RET
