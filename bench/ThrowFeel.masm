; Thrown by hand, held by its own order: it only feels its neighbours, and pulls back toward thicker mana when it's at the edge.
        .use  Bench, Shapes, Reactions, Transformations, Orders

ThrowFeel:
        CALL  pour
        CALL  edge                ; how thin the edge is: all it's told
        ORDR  n16, .order
        CALL  release
        CALL  aim
        MOV   n4, n16
        CALL  throw
        LOCK  n16, INPUT
        MOV   n0, n16
        HALT

.order: GETW  n5, #0              ; the phase: 0 flying, 1 bursting
        CMP   n5, #0
        JNE   .burst
        CALL  touch
        CMP   n5, #0
        JNE   .hit
        CALL  feel
        RET
.hit:   PUTW  #0, n5              ; the whole weave bursts from the next tick
        PUTW  #4, n4
        RET
.burst: CALL  feelBurst
        RET
