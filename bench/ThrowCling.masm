; Thrown by hand, held by its own order: it kicks itself back toward thicker mana when it strays past the edge (the Fireball).
        .use  Bench, Reactions, Transformations, Orders

ThrowCling:
        CALL  pour
        ORDR  n16, .order
        CALL  release
        CALL  aim
        MOV   n4, n16
        CALL  throw
        LOCK  n16, INPUT
        MOV   n0, n16
        HALT

.order: GETW  n5, #0              ; the phase: 0 flying, 1 bursting
        CMP   n5, #0
        JNE   .burst
        CALL  touch
        CMP   n5, #0
        JNE   .hit
        CALL  cling
        RET
.hit:   PUTW  #0, n5              ; the whole weave bursts from the next tick
        PUTW  #4, n4
        RET
.burst: CALL  burst
        RET
