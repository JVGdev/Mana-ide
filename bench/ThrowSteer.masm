; Thrown by its own order: it's told an angle and a speed, feels its own speed, and kicks itself toward the one it's told. That also cancels its spreading.
; The caster only pours it, ingrains it and lets go.
        .use  Bench, Reactions, Transformations, Orders

ThrowSteer:
        CALL  pour
        CALL  aim
        WSET  n16, #1, n3           ; the angle, up from forward
        IN    n6, FORCE
        WSET  n16, #7, n6           ; the speed
        ORDR  n16, .order
        CALL  release
        LOCK  n16, INPUT
        MOV   n0, n16
        HALT

.order: GETW  n5, #0              ; the phase: 0 flying, 1 bursting
        CMP   n5, #0
        JNE   .burst
        CALL  touch
        CMP   n5, #0
        JNE   .hit
        CALL  steer
        RET
.hit:   PUTW  #0, n5              ; the whole weave bursts from the next tick
        PUTW  #4, n4
        RET
.burst: CALL  burst
        RET
