{
  "name": "mana",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A machine, a language and a spell tester for Ikozu's magic",
  "scripts": {
    "test": "cargo test --manifest-path engine/Cargo.toml",
    "check": "cargo clippy -q --manifest-path engine/Cargo.toml --workspace --tests -- -D warnings && npm run engine:wasm && tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --workspace tester --fail-on-warnings",
    "tester": "npm run engine:wasm && vite --config tester/vite.config.ts",
    "build:tester": "npm run engine:wasm && vite build --config tester/vite.config.ts",
    "engine:wasm": "wasm-pack build engine/mana-wasm --target web --release",
    "bench": "cargo run -q --release --manifest-path engine/Cargo.toml -p mana-cli --bin bench --",
    "listings": "tsx scripts/listings.ts",
    "mas": "cargo run -q --release --manifest-path engine/Cargo.toml -p mana-cli --bin mas --",
    "mvm": "cargo run -q --release --manifest-path engine/Cargo.toml -p mana-cli --bin mvm --"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.20.5",
    "codemirror": "^6.0.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
