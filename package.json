{
  "name": "mana",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A machine, a language and a spell tester for Ikozu's magic",
  "bin": {
    "mas": "src/cli/mas.ts",
    "mvm": "src/cli/mvm.ts"
  },
  "scripts": {
    "test": "vitest run",
    "check": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --workspace tester --fail-on-warnings",
    "tester": "vite --config tester/vite.config.ts",
    "build:tester": "vite build --config tester/vite.config.ts",
    "bench": "tsx src/cli/bench.ts",
    "listings": "tsx scripts/listings.ts",
    "mas": "tsx src/cli/mas.ts",
    "mvm": "tsx src/cli/mvm.ts"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.20.5",
    "codemirror": "^6.0.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
